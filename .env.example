# Example env (never commit real secrets). Routing needs no repo secrets.

# Postgres (docker compose up -d db — pgvector/pgvector:pg16)
ACI_DATABASE_URL=postgresql+psycopg://aci:aci@localhost:5432/aci
ACI_LOG_LEVEL=INFO

# Content-addressed blob store root (gitignored)
ACI_OBJECT_STORE_ROOT=data/objects

# Retrieval embedder: "hashing" (offline deterministic default) or
# "fastembed" (local ONNX semantic model — needs the `semantic` extra)
ACI_EMBEDDER=hashing
# ACI_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5

# Base URL this service is reachable at (A2A Agent Card, V3 §56)
ACI_SERVICE_URL=http://localhost:8000

# OpenAI-compatible endpoint for the delegated-task executor (V3 §56.1).
# Empty = no executor configured (A2A surface stays honest).
ACI_AGENT_MODEL_BASE_URL=
ACI_AGENT_MODEL_API_KEY=

# JSON file holding AgentProfile records (deployment DATA, §56.1).
# Empty = no profiles configured.
ACI_AGENT_PROFILES_PATH=

# Bearer token guarding every /v1/agent-runs route. Empty = UNAUTHENTICATED
# mode (keep the port on localhost — a startup warning says so); set it
# before exposing the surface beyond localhost.
ACI_AGENT_RUNS_TOKEN=
